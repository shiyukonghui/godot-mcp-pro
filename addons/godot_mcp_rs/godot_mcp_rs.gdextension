[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"

[libraries]
windows.x86_64  = "res://addons/godot_mcp_rs/godot_mcp_gdext.dll"
linux.x86_64    = "res://addons/godot_mcp_rs/libgodot_mcp_gdext.so"
macos.debug     = "res://addons/godot_mcp_rs/libgodot_mcp_gdext.framework"
